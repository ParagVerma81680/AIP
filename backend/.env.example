# Database (Supports SQLite local dev or PostgreSQL / Supabase)
# SQLite example: sqlite+aiosqlite:///./swiftmart.db
# PostgreSQL / Supabase example: postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./swiftmart.db

SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173","https://paragverma81680.github.io"]

# AIP Multi-Provider Configuration
# Supported providers: groq, openai, gemini, anthropic, mock
AI_PROVIDER=groq
AI_API_KEY=your-api-key-here
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AIP_SYSTEM_IDENTITY=You are AIP, an intelligent, helpful, conversational AI assistant. You can help with general knowledge, coding, education, reasoning, document analysis and practical tasks. Be honest about uncertainty, maintain conversational context and never fabricate facts.
